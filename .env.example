# Copia este archivo como ".env" y coloca tus valores reales.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Puerto del servidor
PORT=3000

# Cadena de conexión a MongoDB (local o MongoDB Atlas)
# Local:  mongodb://127.0.0.1:27017/tienda_virtual
# Atlas:  mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/tienda_virtual
MONGO_URI=mongodb://127.0.0.1:27017/tienda_virtual

# Clave secreta para firmar los tokens JWT (escribe una frase larga y difícil de adivinar)
JWT_SECRET=<escribe_aqui_tu_clave_secreta>

# Tiempo de expiración del token
JWT_EXPIRES_IN=1h
